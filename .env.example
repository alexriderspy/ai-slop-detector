# Copy to .env and edit. Load it with:  set -a; source .env; set +a
# Local (default): Ollama's OpenAI-compatible API
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
# Cloud instead: point the same three at any OpenAI-compatible provider, e.g.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# The small model that measures perplexity (downloaded from Hugging Face on first use)
SCORER_MODEL=unsloth/Llama-3.2-1B-Instruct
